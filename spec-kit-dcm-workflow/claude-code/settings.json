{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dcm-before-commit-review.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./spec-kit-dcm-workflow/scripts/dcm-precheck.sh:*)",
      "Bash(./spec-kit-dcm-workflow/scripts/dcm-model-pref.sh:*)",
      "Bash(./spec-kit-dcm-workflow/scripts/dcm-parse-tasks.sh:*)",
      "Bash(./spec-kit-dcm-workflow/scripts/dcm-conflict-check.sh:*)",
      "Bash(spec-kit-dcm-workflow/scripts/dcm-precheck.sh:*)",
      "Bash(spec-kit-dcm-workflow/scripts/dcm-model-pref.sh:*)",
      "Bash(spec-kit-dcm-workflow/scripts/dcm-parse-tasks.sh:*)",
      "Bash(spec-kit-dcm-workflow/scripts/dcm-conflict-check.sh:*)",
      "Bash(./spec-kit-dcm-workflow/scripts/dcm-selftest.sh)",
      "Bash(spec-kit-dcm-workflow/scripts/dcm-selftest.sh)"
    ]
  }
}
