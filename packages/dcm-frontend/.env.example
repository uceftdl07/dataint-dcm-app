# DCM Frontend — environment variables (copy to .env and fill values)

# API Gateway endpoint (dcm-backend)
# Development: http://localhost:8080 (proxied by Vite dev server via /api)
# Dev remote:  https://api.dcmd.alzp.tgscloud.net
# Prod:        https://api.dcm.alzp.tgscloud.net
VITE_API_BASE_URL=http://localhost:8080

# Microsoft Entra ID — App Registration for DCM Frontend
VITE_AZURE_TENANT_ID=your-tenant-id
VITE_AZURE_CLIENT_ID=your-dcm-frontend-client-id

# Scope for dcm-backend JWT tokens (matches Lambda Authorizer audience)
VITE_AZURE_SCOPE=api://dcm-backend/.default

# Redirect URI after login
# Dev remote: https://dcmd.alzp.tgscloud.net
# Prod:       https://dcm.alzp.tgscloud.net
VITE_REDIRECT_URI=http://localhost:4000

# Enable Entra ID authentication (true = enabled, false = dev bypass)
VITE_ENABLE_AUTH=false
