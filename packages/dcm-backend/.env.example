# DCM Backend — variables d'environnement (copier vers .env et remplir)
# Toutes les variables sont préfixées DCM_

# Databricks SQL Warehouse (prod runtime — voir MIGRATION-LAKEBASE-TO-WAREHOUSE.md)
DCM_DATABRICKS_HOST=
DCM_DATABRICKS_WAREHOUSE_ID=
DCM_DATABRICKS_CATALOG=it
# ba_data_connect_monitoring__d en dev, ba_data_connect_monitoring__p en prod
DCM_DATABRICKS_SCHEMA=ba_data_connect_monitoring__d
DCM_DATABRICKS_SPN_CLIENT_ID=
DCM_DATABRICKS_SPN_CLIENT_SECRET=

# Entra ID — validation JWT
DCM_ENTRA_TENANT_ID=
DCM_ENTRA_CLIENT_ID=

# CORS (utilisé par CORSSettings — pas DCM_ALLOWED_ORIGINS)
DCM_CORS_ALLOWED_ORIGINS=http://localhost:4000 https://dcmd.alzp.tgscloud.net

# Frontend URL (liens Teams, notifications)
DCM_FRONTEND_URL=http://localhost:4000

# Chat / Genie
DCM_CHAT_PROVIDER=genie
DCM_GENIE_SPACE_ID=

# Collectors admin API
DCM_COLLECTOR_API_KEY=

# Environnement
DCM_ENVIRONMENT=development

# Dev only — ne jamais activer en prod
# DCM_AUTH_DISABLED=true
