# DCM Backend Configuration — Add these to your .env or Key Vault

# Teams Webhook for Access Request Notifications
# How to get this:
# 1. Go to your Teams channel
# 2. Click ⋯ (More options) → Connectors
# 3. Search for "Incoming Webhook"
# 4. Click "Configure"
# 5. Give it a name (ex: "DCM Access Requests")
# 6. Copy the webhook URL
DCM_TEAMS_WEBHOOK_URL=

# Frontend URL for Teams notification links
# Development: http://localhost:4000
# Production: https://dcm.alzp.tgscloud.net
DCM_FRONTEND_URL=http://localhost:4000
