# Exemple de configuration .env pour dcm-azure-collector
# Copiez ce fichier en .env et remplissez les valeurs nécessaires

# Obligatoire : URL complète du Key Vault Azure
DCM_KEY_VAULT_URL=https://votre-keyvault.vault.azure.net/

# Obligatoire : ID de souscription Azure surveillée
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Obligatoire : Identifiant du landing zone/source (ex: sub-iasp-lz-DataSquad)
DCM_SOURCE_LZ_ID=sub-iasp-lz-xxxxxxx

# Obligatoire : URL de base du proxy Apigee (ex: https://api.example.com/dcm)
DCM_APIGEE_BASE_URL=https://api.example.com/dcm

# Obligatoire : Identifiants Entra ID (ex-Azure AD)
DCM_ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DCM_ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DCM_ENTRA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obligatoire : Clé API Apigee
DCM_APIGEE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : Scope OAuth2 pour Entra ID (défaut : api://dcm-ingestion/.default)
DCM_ENTRA_SCOPE=api://dcm-ingestion/.default

# Optionnel : Intervalle de collecte en secondes (défaut : 300)
DCM_COLLECTION_INTERVAL=300

# Optionnel : Lookback ADF pipeline en heures (défaut : 1)
DCM_PIPELINE_LOOKBACK_HOURS=1

# Optionnel : Liste des collecteurs activés (séparés par des virgules)
DCM_ENABLED_COLLECTORS=datafactory,databricks,cost_management,databases,security_center

# Optionnel : Mode local/dev (1 = enregistre les payloads en local, 0 = envoi Apigee)
DCM_LOCAL_DEV=0
