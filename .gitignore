docker-compose.override.yml

# =============================================================================
# FICHIERS TEMPORAIRES ET LOGS
# =============================================================================
*.log
*.tmp
*.temp
*.bak
*.backup
reprise.txt

# Backups drawio
.**/*.bkp
dcm-docs/**/*.bkp

# =============================================================================
# ARCHIVES
# =============================================================================
*.rar
*.zip
*.tar.gz
*.7z

# =============================================================================
# SPEC-KIT LOCAL ARTIFACTS — never push in PRs (agent/workflow only)
# =============================================================================
specs/**/.pr-shell/
specs/**/branches-created.json
specs/**/data-model.md
specs/**/jira-create-log.json
specs/**/merge-strategy.md
specs/**/quickstart.md
specs/**/research.md

# databricks-data-validator: SQL rendu + findings/plan/rapport de validation (local uniquement)
specs/**/validation-*.md
specs/**/validation-*.sql

